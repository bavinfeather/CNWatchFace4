import Toybox.Test;
(:test) function moonOfficial2026Frames(logger) {
    var s=new Landscape();
    var rows=[
        [1767434580,14],
        [1768060080,21],
        [1768765920,0],
        [1769402820,7],
        [1769983740,14],
        [1770640980,21],
        [1771329660,0],
        [1771936020,7],
        [1772537880,14],
        [1773221880,21],
        [1773883380,0],
        [1774466280,7],
        [1775095920,14],
        [1775796660,21],
        [1776426720,0],
        [1776997920,7],
        [1777656180,14],
        [1778361000,21],
        [1778961660,0],
        [1779534660,7],
        [1780217100,14],
        [1780912800,21],
        [1781492040,0],
        [1782078900,7],
        [1782777360,14],
        [1783452540,21],
        [1784022180,0],
        [1784631900,7],
        [1785335760,14],
        [1785982860,21],
        [1786556220,0],
        [1787193960,7],
        [1787890680,14],
        [1788508260,21],
        [1789097220,0],
        [1789764240,7],
        [1790441340,14],
        [1791033900,21],
        [1791647400,0],
        [1792339920,7],
        [1792987920,14],
        [1793564880,21],
        [1794207720,0],
        [1794916080,7],
        [1795531980,14],
        [1796105280,21],
        [1796777520,0],
        [1797486120,7],
        [1798075680,14],
        [1798657140,21]
    ];
    for(var i=0;i<rows.size();i+=1) {
        var phase=s.moonPhase(rows[i][0]);
        logger.debug(rows[i][0]+" phase="+phase);
        Test.assert(s.moonFrame(phase)==rows[i][1]);
    }
    return true;
}
